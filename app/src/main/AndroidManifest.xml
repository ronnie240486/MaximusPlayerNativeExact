<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Lembrete de programação: notificação real no horário do programa. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="Maximus Player"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MacLoginActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".WelcomeActivity" android:screenOrientation="landscape" />
        <activity android:name=".FavoritesActivity" android:screenOrientation="landscape" />
        <activity android:name=".DiagnosticActivity" android:screenOrientation="landscape" />
        <activity android:name=".SettingsActivity" android:screenOrientation="landscape" />
        <activity android:name=".MainActivity" android:screenOrientation="landscape" />
        <activity
            android:name=".PlayerActivity"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity android:name=".CameraViewActivity" android:screenOrientation="landscape" />
        <activity android:name=".WorldCamerasActivity" android:screenOrientation="landscape" />
        <activity android:name=".ScoreActivity" android:screenOrientation="landscape" />
        <activity android:name=".RadioActivity" android:screenOrientation="landscape" />
        <activity android:name=".CatalogActivity" android:screenOrientation="landscape" />
        <activity android:name=".PlaylistsActivity" android:screenOrientation="landscape" />
        <activity android:name=".ContentDetailsActivity" android:screenOrientation="landscape" />
        <activity android:name=".TrailerActivity" android:screenOrientation="landscape" />
        <activity android:name=".SearchActivity" android:screenOrientation="landscape" />
        <activity
            android:name=".ChannelDetailsActivity"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ChannelsActivity"
            android:screenOrientation="landscape"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />
        <activity android:name=".ProfilesActivity" android:screenOrientation="landscape" />
        <activity android:name=".SidebarOrderActivity" android:screenOrientation="landscape" />
        <activity android:name=".ProfileEditActivity" android:screenOrientation="landscape" />
        <receiver android:name=".ProgramReminderReceiver" android:exported="false" />
    </application>
</manifest>
